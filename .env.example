# ==============================================================================
# STUDY PLANNER ENVIRONMENT CONFIGURATION
# Set these in the AI Studio Secrets panel or Cloud Run environment variables.
# ==============================================================================

# 1. Gemini AI API Key
# Automatically injected by AI Studio when added to Secrets.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# 2. Cloud Database URL (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# If left unset, Study Planner automatically uses high-performance persistent
# storage in /data so the application works out-of-the-box without manual setup.
DATABASE_URL=postgresql://postgres:password@db.cloud.neon.tech/study_planner?sslmode=require
